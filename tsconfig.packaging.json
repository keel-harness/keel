{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "sourceMap": false
  },
  "include": [
    "packaging/**/*.ts",
    "packaging/**/*.d.ts",
    "packaging/process-group-cleanup.mjs",
    "packaging/process-group-controller.mjs",
    "packaging/process-group-guardian.mjs",
    "packaging/bounded-output-capture.mjs",
    "packages/kernel/src/version.ts"
  ],
  "exclude": ["packaging/**/*.test.ts"]
}
